---
import { ascii } from '../data/site.js';

interface Props {
  project: {
    name: string;
    glyph: string;
    labels: string[];
    platform?: string;
    description: string;
    links: { label: string; href: string }[];
  };
}
const { project } = Astro.props;
const [primaryLink, ...secondaryLinks] = project.links;
const art = ascii[project.glyph]?.replace(/^\n/, '') ?? '';
---

<li class="entry">
  <pre class="entry__glyph" aria-hidden="true">{art}</pre>
  <div>
    <h3 class="entry__name">
      {primaryLink ? <a href={primaryLink.href}>{project.name}</a> : project.name}
    </h3>
    <p class="entry__labels">
      {project.labels.map((l) => <span class="label">{l}</span>)}
      {project.platform && <span>{project.platform}</span>}
    </p>
    <p class="entry__desc">{project.description}</p>
    {
      secondaryLinks.length > 0 && (
        <p class="entry__links">
          {secondaryLinks.map((link) => (
            <a class="link" href={link.href}>
              {link.label}
            </a>
          ))}
        </p>
      )
    }
  </div>
</li>
